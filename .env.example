# ── Required ──────────────────────────────────────────────
# PostgreSQL connection string (e.g. from neon.tech — free tier works)
DATABASE_URL=postgresql://user:password@host/dbname

# ── Optional: server-side API keys ────────────────────────
# If not set, users can paste their own key in the app's Model settings.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
